{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Exceptions", "Serilog.Expressions", "Serilog.Sinks.Async" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level,-5} {CorrelationId} {SourceContext}:{LineNumber} - {Message:lj}{NewLine}"
              }
            }
          ]
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithExceptionDetails",
      {
        "Name": "WithCallerInfo",
        "Args": {
          "includeFileInfo": "true",
          "assemblyPrefix": "ServiceRequestTracker.",
          "startingAssembly": "ServiceRequestTracker.API"
        }
      }
    ],
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "RequestPath like '%swagger%' or RequestPath like '%.js' or RequestPath like '%.json'"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
